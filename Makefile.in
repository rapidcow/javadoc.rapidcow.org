#
# Transformation rules from ${a}/% to ${b}/%
#
index.html trivnote/index.html trivnote/libexpr/index.html: ${A}/render
	cd -- ${A:Q} && ${^X} render -B ${B:Q} $a/${.TARGET} ${B:Q}/${b}/${.TARGET}
robots.txt ai/assets/site.css ai/assets/site.js:
	cd -- ${A:Q} && cp $a/${.TARGET} ${B:Q}/${b}/${.TARGET}
