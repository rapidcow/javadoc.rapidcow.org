#!/usr/bin/env perl
# HAVE: render
# NEED: ${B}/MY/option.mk

use 5.006;
use strict;

use Data::Dumper;
use Fcntl qw(O_CREAT O_WRONLY);
use Getopt::Std;
use POSIX ();

use Template;
use Template::Exception;

use FindBin;
use lib "$FindBin::RealBin/lib";   # Local::
use RdKw::WwW::GenGenLib qw( load_state );
use RdKw::WwW::GenLib qw( locate location );

my $prog = $0;

sub HELP_MESSAGE
{
	<<USE;
usage: $prog [-dh] [-B BUILDDIR] [-m MODE] apath bpath

  -B DIR    build directory, where MY/option.mk lives (default: .)
  -d        enable debug output
  -h        print this help message
  -m MODE   file mode
USE
}

# -B could be thought of as CMake's -S <source> / -B <build>.
# (-S would be redundant though, since cd ${A} covers that. ;)
my %o;
getopts('B:dhm:', \%o) or die +(split /^/, HELP_MESSAGE)[0];
if ($o{h}) {
	print HELP_MESSAGE();
	exit;
}

@ARGV == 2 or die "$0: need exactly two args, not @{[scalar @ARGV]}\n";
my ($apath, $bpath) = @ARGV;

sub LOG {
	my $mesg = join $,, @_;
	my (undef, $file, $line) = caller;
	for (split /^/, $mesg) {
		chomp;
		print sprintf "%s:%03d: %s\n", $file, $line, $_;
	}
}

# D and O, each in a namespace of its own: [% D.b %], [% O.base_url %]
my ($D, $O) = @{+{ load_state(defined $o{B} ? $o{B} : '.') }}{qw( config option )};
if ($o{d}) {
	local $Data::Dumper::Varname = "D";
	LOG "YOUR defs!\n";
	LOG Dumper $D;
	local $Data::Dumper::Varname = "O";
	LOG "YOUR options!\n";
	LOG Dumper $O;
}

my %O = (%$O, location => location($D, $bpath));

my %V = (
	D => $D,
	O => \%O,
	# Specific to this site, and not to siteconf: where base_url is not
	# http(s), a path naming a directory is spelled out as its index.html
	# (so that the links also work from file://).
	locate => sub {
		@_ == 1 or die "usage: [% locate PATH %]\n";
		my ($where) = @_;
		if ($O{base_url} !~ m{^https?://}i) {
			$where .= 'index.html' if !length($where)
				|| $where =~ m{/$};
		}
		locate(\%O, $O{location}, $where);
	},
);

my $tt = Template->new({
	INCLUDE_PATH => [ 'skel', '.' ],
	PLUGIN_BASE => 'Local::Plugin',
	# TT's own DataFile.pm shadows ours :,(
	PLUGINS => {
		DataFile => 'Local::Plugin::DataFile',
	},
}) or die "[TT] ", $Template::ERROR, "\n";

my $if;
open($if, '<:encoding(UTF-8)', $apath)
	or die "open <$apath: $!\n";

my $of;
$o{m} ? sysopen($of, $bpath, O_CREAT | O_WRONLY, oct($o{m})) :
	open($of, '>', $bpath)
	or die "open >$bpath: $!\n";
binmode($of, ":encoding(UTF-8)");

sub giveup {
	my ($trap) = @_;
	print STDERR "$prog: SIG${trap} caught! Bye bye....\n";
	close $of;
	unlink $bpath;
	$SIG{$trap} = 'DEFAULT';
	POSIX::raise($trap);
}
for my $trap (qw( INT HUP TERM )) {
	$SIG{$trap} = \&giveup;
}

unless ($tt->process($if, \%V, $of)) {
	close $of;
	unlink $bpath;
	die "[TT] ", $tt->error();
}

close $of or die "close >$bpath: $!\n";
close $if;
