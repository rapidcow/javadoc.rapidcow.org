#!/usr/bin/env perl
# HAVE: render
# NEED: ${B}/MY/option.mk

use 5.006;
use strict;

use Data::Dumper;
use Fcntl qw(O_CREAT O_WRONLY);
use Getopt::Std;
use POSIX ();

use Template;
use Template::Exception;

use FindBin;
use lib "$FindBin::RealBin/lib";   # Local::
use RdKw::WwW::GenGenLib 0.0002 qw(
	read_deps load_state
	norm_dep subs_dep uproot );
use RdKw::WwW::GenLib 0.0203 qw( locate );
use RdKw::WwW::GenGenLib::Template::Provider;

my $prog = $0;

sub HELP_MESSAGE
{
	<<USE;
usage: $prog [-dh] [-B BUILDDIR] [-m MODE] apath bpath

  -B DIR    build directory, where MY/option.mk lives (default: .)
  -d        enable debug output
  -h        print this help message
  -m MODE   file mode
USE
}

# -B could be thought of as CMake's -S <source> / -B <build>.
# (-S would be redundant though, since cd ${A} covers that. ;)
my %o;
getopts('B:dhm:', \%o) or die +(split /^/, HELP_MESSAGE)[0];
if ($o{h}) {
	print HELP_MESSAGE();
	exit;
}

@ARGV == 2 or die "$0: need exactly two args, not @{[scalar @ARGV]}\n";
my ($apath, $bpath) = @ARGV;

sub LOG {
	my $mesg = join $,, @_;
	my (undef, $file, $line) = caller;
	for (split /^/, $mesg) {
		chomp;
		print sprintf "%s:%03d: %s\n", $file, $line, $_;
	}
}

#
# Load configuration parameters and build options, so
# we can expose them to the template.
#
my ($D, $O) = @{+{ load_state(defined $o{B} ? $o{B} : '.') }}{qw( config option )};
if ($o{d}) {
	local $Data::Dumper::Varname = "D";
	LOG "YOUR defs!\n";
	LOG Dumper $D;
	local $Data::Dumper::Varname = "O";
	LOG "YOUR options!\n";
	LOG Dumper $O;
}

#
# Find ourselves from the dependency graph declarations.
# This pattern is purely symbolic, though we also accept
# literal spelling, since some people like to treat ${a}
# as a predefined constant (like how ${A} is).
#
my %I = read_deps($apath);
defined $I{HAVE} or die "E: $apath: HAVE declaration not found\n";
# relapath doesn't do well with the leading slash,
# though people may have a habit of including it...
(my $target = do {
	my ($name, $norm, $real);
	# Try symbolic prefix
	if (defined ($name = uproot('${a}',
		$norm = norm_dep($I{HAVE}))))
	{
		subs_dep($D, $name);
	}
	# Try literal prefix
	elsif (defined ($name = uproot($D->{a},
		$real = subs_dep($D, $norm))))
	{
		$name;
	}
	else {
		my $aka = $real eq $I{HAVE} ? "" : " (which is `$real')";
		die "E: $apath: HAVE `$I{HAVE}'$aka not "
			. "under \${a} (which is `$D->{a}')\n";
	}
}) =~ s/\A\/+//;

my %V = (
	D => $D,
	O => $O,
	# Where this page lives, relative to ${a} (as in `HAVE').
	location => $target,
	# Specific to this site, and not to siteconf: where base_url is not
	# http(s), a path naming a directory is spelled out as its index.html
	# (so that the links also work from file://).
	locate => sub {
		my $where = locate($O, $target, @_);
		if ($O->{base_url} !~ m{^https?://}i) {
			$where .= 'index.html' if !length($where)
				|| $where =~ m{/$};
		}
		$where;
	},
	location => $target,
);

my $provider = RdKw::WwW::GenGenLib::Template::Provider->new({
	SOURCE => $apath,
	DEFINITION => $D,
	ENCODING => 'UTF-8',
	INCLUDE_PATH => [ '.', $D->{a}, 'skel' ],
	CHECK_DEPS => 1,
})
	or die "[TT] ", RdKw::WwW::GenGenLib::Template::Provider->error(), "\n";

my $tt = Template->new({
	LOAD_TEMPLATES => [ $provider ],
	INCLUDE_PATH => [ 'skel', '.' ],
	PLUGIN_BASE => 'Local::Plugin',
	# TT's own DataFile.pm shadows ours :,(
	PLUGINS => {
		DataFile => 'Local::Plugin::DataFile',
	},
}) or die "[TT] ", $Template::ERROR, "\n";

my $if;
open($if, '<:encoding(UTF-8)', $apath)
	or die "open <$apath: $!\n";

my $of;
$o{m} ? sysopen($of, $bpath, O_CREAT | O_WRONLY, oct($o{m})) :
	open($of, '>', $bpath)
	or die "open >$bpath: $!\n";
binmode($of, ":encoding(UTF-8)");

sub giveup {
	my ($trap) = @_;
	print STDERR "$prog: SIG${trap} caught! Bye bye....\n";
	close $of;
	unlink $bpath;
	$SIG{$trap} = 'DEFAULT';
	POSIX::raise($trap);
}
for my $trap (qw( INT HUP TERM )) {
	$SIG{$trap} = \&giveup;
}

unless ($tt->process($if, \%V, $of)) {
	close $of;
	unlink $bpath;
	die "[TT] ", $tt->error();
}

close $of or die "close >$bpath: $!\n";
close $if;
